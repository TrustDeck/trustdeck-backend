# Add curl to keycloak to enable health checks
# Use an image that includes a package manager
FROM registry.access.redhat.com/ubi9 AS ubi-micro-build

# Switch to root user
USER root

# Create folder and install curl in it
RUN mkdir -p /mnt/rootfs
RUN dnf install --installroot /mnt/rootfs curl --releasever 9 --setopt install_weak_deps=false --nodocs -y && \
    dnf --installroot /mnt/rootfs clean all && \
    rpm --root /mnt/rootfs -e --nodeps setup

# Start creating standard keycloak and copy the curl installation into the standard image
# Pin the version: a new Keycloak version can change behavior (e.g. 26.8.2 requires the
# kc-admin-api client scope for the admin API), so upgrades should be deliberate.
FROM quay.io/keycloak/keycloak:26.8.2
COPY --from=ubi-micro-build /mnt/rootfs /

# Copy every repository-provided Keycloak theme into the standard theme directory.
# The first-level directory name below keycloak-login-themes becomes the Keycloak theme name.
COPY src/main/resources/keycloak-themes/ /opt/keycloak/themes/
USER root
RUN chmod -R a+rX /opt/keycloak/themes
USER 1000

